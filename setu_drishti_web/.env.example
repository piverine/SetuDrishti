# ─────────────────────────────────────────────────────────────
# Setu-Drishti Web — Environment Variables
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Vercel: set these in the Vercel dashboard under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# The URL of your Render-hosted FastAPI backend.
# Example: https://setu-drishti-backend.onrender.com
# Leave empty / as-is for local development (falls back to localhost:8000)
VITE_API_URL=https://your-backend.onrender.com

# (Optional) Clerk publishable key for authentication.
# If not provided, the app runs in mockup/demo auth mode automatically.
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxx
